    )

    return true
end

local function DirectReady()
    local gameStateReplicator =
        GetDirectGameStateReplicator()

    local voteReplicator =
        GetDirectVoteReplicator()

    if not gameStateReplicator
        or not voteReplicator then

        return false
    end

    if gameStateReplicator:GetAttribute(
        "GameStarted"
    ) == true then

        return true
    end

    repeat
        if gameStateReplicator:GetAttribute(
            "GameOver"
        ) == true then

            return false
        end

        task.wait(0.1)
    until (
        voteReplicator:GetAttribute("Enabled") == true
        and voteReplicator:GetAttribute("Title") == "Ready?"
    )
        or gameStateReplicator:GetAttribute(
            "GameStarted"
        ) == true

    if gameStateReplicator:GetAttribute(
        "GameStarted"
    ) ~= true then

        pcall(function()
            rf:InvokeServer(
                "Voting",
                "Skip"
            )
        end)
    end

    repeat
        if gameStateReplicator:GetAttribute(
            "GameOver"
        ) == true then

            return false
        end

        task.wait(0.1)
    until gameStateReplicator:GetAttribute(
        "GameStarted"
    ) == true

    return true
end

local function DirectUpgradeTower(index, path)
    local tower =
        TDS.PlacedTowers[index]

    if not tower
        or not tower.Parent then

        return false
    end

    while IsStrategyRuntimeEnabled() do
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Troops",
                    "Upgrade",
                    "Set",
                    {
                        Troop = tower,
                        Path = path or 1
                    }
                )
            end)

        if ok and DirectResponseOK(result) then
            return true
        end

        task.wait(0.25)
    end

    return false
end

