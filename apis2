local function DirectGetCurrentWave()
    local label

    repeat
        local gameStateReplicator =
            GetDirectGameStateReplicator()

        if gameStateReplicator
            and gameStateReplicator:GetAttribute("GameOver") == true then

            return nil
        end

        local guiObject =
            PlayerGui:FindFirstChild(
                "ReactGameTopGameDisplay"
            )

        local frameObject =
            guiObject
            and guiObject:FindFirstChild("Frame")

        local waveObject =
            frameObject
            and frameObject:FindFirstChild("wave")

        local container =
            waveObject
            and waveObject:FindFirstChild("container")

        label =
            container
            and container:FindFirstChild("value")

        if not label then
            task.wait(0.2)
        end
    until label

    return tonumber(
        tostring(label.Text):match("(%d+)")
    ) or 0
end

local function DirectWaitForWave(target)
    while IsStrategyRuntimeEnabled() do
        local currentWave =
            DirectGetCurrentWave()

        if currentWave
            and currentWave >= target then

            return true
        end

        task.wait(0.25)
    end

    return false
end

