function TDS:Place(towerName, x, y, z, ...)
    local args = {...}
    local isStacking =
        args[#args] == true
        or args[#args] == "stack"

    local position = Vector3.new(x, y, z)

    if isStacking then
        local baseY = tonumber(y) or 0

        
        
        if math.abs(baseY) < 0.001 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude

            local ignore = {}
            local towersFolder = workspace:FindFirstChild("Towers")

            if towersFolder then
                table.insert(ignore, towersFolder)
            end

            if plr.Character then
                table.insert(ignore, plr.Character)
            end

            rayParams.FilterDescendantsInstances = ignore

            local hit = workspace:Raycast(
                Vector3.new(x, 250, z),
                Vector3.new(0, -1000, 0),
                rayParams
            )

            if not hit then
                ProtectedNoop("[STACKER] No surface found:", towerName, x, y, z)
                return false
            end

            baseY = hit.Position.Y
        end

        local stackKey = string.format("%.5f|%.5f", tonumber(x) or 0, tonumber(z) or 0)
        local stackNumber = (self.StackCounts[stackKey] or 0) + 1
        self.StackCounts[stackKey] = stackNumber

        position = Vector3.new(
            x,
            baseY + 25 + ((stackNumber - 1) * 3.5),
            z
        )
    end

    local towersFolder = workspace:WaitForChild("Towers")

    local existing = {}

    for _, tower in ipairs(towersFolder:GetChildren()) do
        local owner = tower:FindFirstChild("Owner")

        if owner and owner.Value == plr.UserId then
            existing[tower] = true
        end
    end

    
    while IsStrategyRuntimeEnabled() do
        local gameStateReplicator = GetDirectGameStateReplicator()

        if gameStateReplicator
            and gameStateReplicator:GetAttribute("GameOver") == true then
            return false
        end

        local ok, result = pcall(function()
            if isStacking then
                return rf:InvokeServer(
                    "Troops",
                    "Place",
                    {
                        Rotation = CFrame.new(),
                        Position = position
                    },
                    towerName
                )
            end

            return rf:InvokeServer(
                "Troops",
                "Place",
                {
                    Rotation = CFrame.new(),
                    Position = position
                },
                towerName,
                unpackArgs(args)
            )
        end)

        if ok and DirectResponseOK(result) then
            break
        end

        task.wait(0.25)
    end

    if not IsStrategyRuntimeEnabled() then
        return false
    end

    local newTower

    repeat
        local gameStateReplicator = GetDirectGameStateReplicator()

        if gameStateReplicator
            and gameStateReplicator:GetAttribute("GameOver") == true then
            return false
        end

        for _, tower in ipairs(towersFolder:GetChildren()) do
            if not existing[tower] then
                local owner = tower:FindFirstChild("Owner")

                if owner and owner.Value == plr.UserId then
                    newTower = tower
                    break
                end
            end
        end

        if not newTower then
            task.wait(0.05)
        end
    until newTower

    table.insert(TDS.PlacedTowers, newTower)
    return #TDS.PlacedTowers
end

local GATLING_AUTO_URL =
    "https://raw.githubusercontent.com/avtryxz/autogutlin/refs/heads/main/autogutlin.lua"

local GatlingAutoLoadStarted = false
local GatlingReservationToken = {}

local GatlingGlobalEnv =
    (getgenv and getgenv())
    or _G

local function IsGatlingAutoLoaded()
    return GatlingGlobalEnv.__RyaAutoGatlingLoaded == true
end

local function OwnsGatlingReservation()
    return GatlingGlobalEnv.__RyaAutoGatlingOwner
        == GatlingReservationToken
end

local function ReserveGatlingLoader()
    if IsGatlingAutoLoaded() then
        return false
    end

    if GatlingGlobalEnv.__RyaAutoGatlingLoading == true
        and not OwnsGatlingReservation() then

        return false
    end

    GatlingGlobalEnv.__RyaAutoGatlingLoading = true
    GatlingGlobalEnv.__RyaAutoGatlingOwner =
        GatlingReservationToken

    return true
end

local function ReleaseGatlingLoader()
    if OwnsGatlingReservation() then
        GatlingGlobalEnv.__RyaAutoGatlingLoading = false
        GatlingGlobalEnv.__RyaAutoGatlingOwner = nil
    end
end

local function HasGatlingGun(loadout)
    for _, towerName in ipairs(loadout) do
        if tostring(towerName) == "Gatling Gun" then
            return true
        end
    end

    return false
end

local function StartGatlingAutoLoadWatcher()
    if GatlingAutoLoadStarted
        or IsGatlingAutoLoaded()
        or TDS.HasGatlingGun ~= true then

        return
    end

    -- Reserve the loader IMMEDIATELY.
    -- Any standalone wrapper using the same shared guard will now
    -- see __RyaAutoGatlingLoading == true and refuse to load early.
    if not ReserveGatlingLoader() then
        return
    end

    GatlingAutoLoadStarted = true

    task.spawn(function()
        while TDS.HasGatlingGun == true
            and not IsGatlingAutoLoaded() do

            local gameStateReplicator =
                GetDirectGameStateReplicator()

            if gameStateReplicator then
                if gameStateReplicator:GetAttribute(
                    "GameOver"
                ) == true then

                    ReleaseGatlingLoader()
                    GatlingAutoLoadStarted = false
                    return
                end

                if gameStateReplicator:GetAttribute(
                    "GameStarted"
                ) == true then

                    local ok =
                        pcall(function()
                            loadstring(
                                game:HttpGet(
                                    GATLING_AUTO_URL
                                )
                            )()
                        end)

                    if ok then
                        GatlingGlobalEnv.__RyaAutoGatlingLoaded = true
                    end

                    ReleaseGatlingLoader()
                    GatlingAutoLoadStarted = false
                    return
                end
            end

            task.wait(0.1)
        end

        ReleaseGatlingLoader()
        GatlingAutoLoadStarted = false
    end)
end

function TDS:Loadout(...)
    local requested =
        {...}

    self.HasGatlingGun =
        HasGatlingGun(
            requested
        )

    if self.HasGatlingGun then
        StartGatlingAutoLoadWatcher()
    end

    if game.PlaceId == LOBBY_PLACE_ID then
        return false
    end

    return DirectSetLoadout(
        unpackArgs(
            requested
        )
    )
end

local function BuildMatchmakingPayload(
    difficulty
)
    difficulty =
        tostring(
            difficulty or ""
        )

    if difficulty == "Trial" then
        return {
            count = 1,
            mode = "Trials"
        }
    end

    local mappedMode =
        TDS.MatchmakingMap[
            difficulty
        ]

    if difficulty == "Hardcore" then
        return {
            mode = "hardcore",
            difficulty = "Easy",
            count = 1
        }
    end

    if difficulty == "Voidcore" then
        return {
            mode = "hardcore",
            difficulty = "Hard",
            count = 1
        }
    end

    if mappedMode then
        local payload = {
            mode = mappedMode,
            count = 1
        }

        if difficulty:match(
            "^Ducky"
        ) then
            payload.difficulty =
                difficulty:gsub(
                    "^Ducky",
                    ""
                )
        end

        return payload
    end

    return {
        difficulty = difficulty,
        mode = "survival",
        count = 1
    }
end

function TDS:Mode(difficulty)
    difficulty =
        tostring(
            difficulty or ""
        )

    if difficulty == "Hardcore Easy" then
        difficulty = "Hardcore"
    end

    self.SavedDifficulty =
        difficulty

    self.SavedMatchmaking =
        BuildMatchmakingPayload(
            difficulty
        )

    local lobbyHud =
        PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        )

    local hotbar =
        PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        )

    -- In a match, Mode only remembers the selected mode.
    -- The strategy will continue into GameInfo().
    if not lobbyHud
        and hotbar then

        return false
    end

    if difficulty == "" then
        return false
    end

    if difficulty == "Trial" then
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        return ok
            and result ~= false
    end

    local frame =
        lobbyHud
        and lobbyHud:FindFirstChild(
            "Frame"
        )

    local matchmaking =
        frame
        and frame:FindFirstChild(
            "matchmaking"
        )

    if not matchmaking then
        return false
    end

    while true do
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        if ok
            and DirectResponseOK(result) then

            return true
        end

        -- Stop retrying once Roblox has already moved us
        -- out of the lobby.
        if not PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        ) then

            return true
        end

        task.wait(0.5)
    end
end

function TDS:GameInfo(mapName, modifiers)
    -- Trial mode has no map voting.
    -- Matchmaking already puts us into the Trial server, so skip
    -- ReactGameIntermission / map lookup / map vote completely.
    if self.SavedDifficulty == "Trial" then
        return true
    end

    -- Same strategy file can run in lobby and in-match.
    -- Do nothing here while matchmaking is still in the lobby.
    if PlayerGui:FindFirstChild(
        "ReactLobbyHud"
    )
        and not PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        ) then

        return false
    end

    local voteGui =
        PlayerGui:WaitForChild(
            "ReactGameIntermission",
            30
        )

    if not voteGui then
        return false
    end

    local frame =
        voteGui:WaitForChild(
            "Frame",
            5
        )

    if not frame then
        return false
    end

    mapName =
        tostring(
            mapName or ""
        )

    local selectedMap,
        rematching =
        WaitForRequestedMapWithFallback(
            mapName,
            self.SavedMatchmaking
        )

    if rematching then
        -- Prevent the rest of the strategy from running
        -- in the wrong server/map while matchmaking moves us.
        while true do
            task.wait(1)
        end
    end

    if not selectedMap then
        return false
    end

    if type(modifiers) == "table"
        and #modifiers > 0 then

        local votes = {}

        for _, modifierName in ipairs(
            modifiers
        ) do
            votes[
                tostring(modifierName)
            ] = true
        end

        pcall(function()
            ReplicatedStorage
                :WaitForChild("Network")
                :WaitForChild("Modifiers")
                :WaitForChild(
                    "RF:BulkVoteModifiers"
                )
                :InvokeServer(votes)
        end)
    end

    return DirectSelectMap(
        selectedMap
    )
end

function TDS:VoteSkip(startWave, endWave)
    if startWave == nil and endWave == nil then
        if HasVIP then
            StartVIPAutoSkip()
        else
            StartDirectAutoSkip()
        end

        return true
    end

    startWave = tonumber(startWave)
    endWave = tonumber(endWave)

    if not startWave or not endWave then
        return false
    end

    startWave = math.floor(startWave)
    endWave = math.floor(endWave)

    if endWave < startWave then
        startWave, endWave = endWave, startWave
    end

    for wave = startWave, endWave do
        VoteSkipWaves[wave] = true
    end

    if HasVIP then
        StartVIPSelectiveSkip()
    else
        StartDirectSelectiveSkip(
            VoteSkipWaves
        )
    end

    return true
end

