local function EnsureVIPSkipWorker()
    if VIPSkipWorkerRunning then
        return
    end

    VIPSkipWorkerRunning = true

    task.spawn(function()
        local lastWanted = nil

        while IsStrategyRuntimeEnabled() do
            local wanted = nil

            if VIPSkipMode == "auto" then
                wanted = true
            elseif VIPSkipMode == "selective" then
                local currentWave =
                    TryGetCurrentWave()

                if currentWave ~= nil then
                    wanted =
                        VoteSkipWaves[
                            currentWave
                        ] == true
                else
                    wanted =
                        VoteSkipWaves[1] == true
                end
            end

            if wanted ~= nil
                and wanted ~= lastWanted then

                if SetAutoSkip(wanted) then
                    lastWanted = wanted
                end
            end

            task.wait(0.1)
        end

        VIPSkipWorkerRunning = false
    end)
end

local function StartVIPAutoSkip()
    VIPSkipMode = "auto"
    SetAutoSkip(true)
    EnsureVIPSkipWorker()
end

local function StartVIPSelectiveSkip()
    VIPSkipMode = "selective"

    local currentWave =
        TryGetCurrentWave()

    if currentWave ~= nil then
        SetAutoSkip(
            VoteSkipWaves[
                currentWave
            ] == true
        )
    elseif VoteSkipWaves[1] == true then
        SetAutoSkip(true)
    else
        SetAutoSkip(false)
    end

    EnsureVIPSkipWorker()
end

