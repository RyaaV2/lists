local function ProtectedNoop(...)
    return ...
end

local function GetDirectStateReplicators()
    return ReplicatedStorage:FindFirstChild("StateReplicators")
end

local function GetDirectGameStateReplicator()
    local stateReplicators = GetDirectStateReplicators()

    return stateReplicators
        and stateReplicators:FindFirstChild("GameStateReplicator")
end

local function GetDirectVoteReplicator()
    local stateReplicators = GetDirectStateReplicators()

    return stateReplicators
        and stateReplicators:FindFirstChild("VoteReplicator")
end

local function IsStrategyRuntimeEnabled()
    local gameStateReplicator = GetDirectGameStateReplicator()

    return not (
        gameStateReplicator
        and gameStateReplicator:GetAttribute("GameOver") == true
    )
end

local function DirectResponseOK(result)
    if result == true then
        return true
    end

    if type(result) == "table"
        and result.Success == true then

        return true
    end

    local ok, isModel = pcall(function()
        return result and result:IsA("Model")
    end)

    if ok and isModel then
        return true
    end

    if type(result) == "userdata" then
        return true
    end

    return false
end

local function DirectGetPlayerReplicator()
    local stateReplicators = GetDirectStateReplicators()

    if not stateReplicators then
        return nil
    end

    for _, folder in ipairs(stateReplicators:GetChildren()) do
        if folder.Name == "PlayerReplicator"
            and folder:GetAttribute("UserId") == plr.UserId then

            return folder
        end
    end

    return nil
end

local function DirectSetLoadout(...)
    local requested = {...}
    local playerReplicator

    repeat
        local gameStateReplicator =
            GetDirectGameStateReplicator()

        if gameStateReplicator
            and gameStateReplicator:GetAttribute("GameOver") == true then

            return false
        end

        playerReplicator =
            DirectGetPlayerReplicator()

        task.wait(0.1)
    until playerReplicator

    local currentlyEquipped = {}
    local equipped =
        playerReplicator:GetAttribute("EquippedTowers")

    if type(equipped) == "string" then
        local json = equipped:match("%[.*%]")

        if json then
            pcall(function()
                currentlyEquipped =
                    HttpService:JSONDecode(json)
            end)
        end
    end

    for _, towerName in ipairs(currentlyEquipped) do
        if towerName and towerName ~= "None" then
            re:FireServer(
                "Inventory",
                "Unequip",
                "Tower",
                towerName
            )

            task.wait(0.3)
        end
    end

    task.wait(0.2)

    for _, towerName in ipairs(requested) do
        if towerName
            and towerName ~= ""
            and towerName ~= "None" then

            re:FireServer(
                "Inventory",
                "Equip",
                "Tower",
                towerName
            )

            task.wait(0.3)
        end
    end

    task.wait(0.2)
    return true
end

